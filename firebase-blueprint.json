{
  "entities": {
    "StaffAccount": {
      "title": "StaffAccount",
      "description": "Authenticated Oda Bultum University user profile, role assignment, and approval status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full legal name of the university employee or officer.",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Institutional or verified Google email address.",
          "minLength": 5,
          "maxLength": 160
        },
        "employeeId": {
          "type": "string",
          "description": "Official Oda Bultum University Employee ID.",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-]+$"
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone number.",
          "minLength": 5,
          "maxLength": 32
        },
        "department": {
          "type": "string",
          "description": "University college, school, or administrative directorate.",
          "minLength": 2,
          "maxLength": 140
        },
        "jobPosition": {
          "type": "string",
          "description": "Academic rank or staff job title.",
          "minLength": 2,
          "maxLength": 120
        },
        "staffTier": {
          "type": "string",
          "description": "Standardized per diem classification tier.",
          "enum": ["SENIOR_ACADEMIC", "LECTURER_RESEARCHER", "ADMIN_SUPPORT"]
        },
        "role": {
          "type": "string",
          "description": "Verified portal role.",
          "enum": ["EMPLOYEE", "ADMINISTRATOR", "FINANCE"]
        },
        "accountStatus": {
          "type": "string",
          "description": "Account authorization status.",
          "enum": ["ACTIVE", "PENDING_APPROVAL", "REJECTED"]
        },
        "passwordHash": {
          "type": "string",
          "description": "SHA-256 salted credential hash.",
          "minLength": 0,
          "maxLength": 128
        },
        "authorizedBy": {
          "type": "string",
          "description": "Name of authorizing administrator.",
          "minLength": 0,
          "maxLength": 120
        },
        "avatar": {
          "type": "string",
          "description": "Profile avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account was last updated."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "employeeId",
        "phone",
        "department",
        "jobPosition",
        "staffTier",
        "role",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoleGrant": {
      "title": "RoleGrant",
      "description": "Trusted role membership document granting Administrator or Finance privileges by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "AccountInvitation": {
      "title": "AccountInvitation",
      "description": "Administrator-provisioned authorization allowing a verified email to activate an Administrator or Finance account.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "employeeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-]+$"
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "jobPosition": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["ADMINISTRATOR", "FINANCE"]
        },
        "passwordHash": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "CLAIMED", "REVOKED"]
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "name",
        "employeeId",
        "phone",
        "department",
        "jobPosition",
        "role",
        "status",
        "authorizedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "TravelRequest": {
      "title": "TravelRequest",
      "description": "Official OBU travel authorization and per diem reimbursement claim.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackingCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "employeeUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "employeeRole": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "destination": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "destinationTier": {
          "type": "string",
          "enum": ["CAPITAL", "REGIONAL_CITY", "REMOTE_WOREDA"]
        },
        "purpose": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "departureDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "returnDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "daysCount": {
          "type": "number"
        },
        "transportMode": {
          "type": "string",
          "enum": ["UNIVERSITY_VEHICLE", "PUBLIC_TRANSPORT", "FLIGHT", "PERSONAL_CAR"]
        },
        "breakdown": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUBMITTED_FOR_APPROVAL",
            "APPROVED_BY_ADMIN",
            "REJECTED_BY_ADMIN",
            "COMPLETED"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "submittedAt": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "approval": {
          "type": "object"
        },
        "payment": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "trackingCode",
        "employeeUid",
        "employeeId",
        "employeeName",
        "employeeRole",
        "department",
        "destination",
        "destinationTier",
        "purpose",
        "departureDate",
        "returnDate",
        "daysCount",
        "transportMode",
        "breakdown",
        "status",
        "submittedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/staff_accounts/{uid}": {
      "schema": { "$ref": "#/entities/StaffAccount" },
      "description": "University staff accounts and pending employee registrations indexed by Firebase UID."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/RoleGrant" },
      "description": "Verified System Administrator role grants."
    },
    "/finance_officers/{uid}": {
      "schema": { "$ref": "#/entities/RoleGrant" },
      "description": "Verified Finance Directorate officer role grants."
    },
    "/account_invitations/{inviteEmail}": {
      "schema": { "$ref": "#/entities/AccountInvitation" },
      "description": "Administrator-issued invitations for Finance and Administrator onboarding."
    },
    "/travel_requests/{requestId}": {
      "schema": { "$ref": "#/entities/TravelRequest" },
      "description": "University employee travel authorization claims, approvals, and payment vouchers."
    }
  }
}
